# M0-R3 隔离验收环境:仅占位凭据,不含任何真实密钥,可安全入库。
JOB_AGENT_APP_ENV=development
JOB_AGENT_LOG_LEVEL=INFO

# 本地占位 API Key(JSON:API key -> 用户 ID),仅用于隔离验收。
JOB_AGENT_API_KEYS={"m0r3-accept-local":"m0r3-user"}

# 刻意不配置 JOB_AGENT_MODEL_*:
# 健康检查、会话与历史端点必须与模型完全解耦。

# Compose 插值来源(--env-file 使用本文件时):验收固定宿主端口。
JOB_AGENT_API_HOST_PORT=18000

# 验收环境的 Vite 代理目标(前端代理链路验证用):指向验收 API。
VITE_API_PROXY_TARGET=http://127.0.0.1:18000
