JOB_AGENT_APP_ENV=development
JOB_AGENT_LOG_LEVEL=INFO

JOB_AGENT_MODEL_TEMPERATURE=0.0
JOB_AGENT_MODEL_TIMEOUT_SECONDS=30
JOB_AGENT_MODEL_MAX_RETRIES=2

# 等确定模型供应商后再填写
# JOB_AGENT_MODEL_PROVIDER=
# JOB_AGENT_MODEL_NAME=
# JOB_AGENT_MODEL_API_KEY=
# JOB_AGENT_MODEL_BASE_URL=

# API 访问密钥:JSON 对象(API key -> 用户 ID),必填。
# 未配置时所有认证端点返回 503(健康检查 /health 不受影响)。
JOB_AGENT_API_KEYS={"change-me-to-a-random-token":"user-001"}

# 聊天 API(compose 的 api 服务)宿主端口;
# 正式切换接管 8000 时改为 8000,并同步移除 dev 的 8000 映射。
JOB_AGENT_API_HOST_PORT=18000